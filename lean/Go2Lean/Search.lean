import Lean.Data.Json
import Go2Lean.Dialect.GoSSA

/-!
# Counterexample search driver

M2's cheapest engine: seeded random testing of a property over a `GoSSA`
program, printing a JSON counterexample to stdout. The Go side generates a
small file that imports a model and calls `Search.run`.

The havoc oracle is derived from the seed, so a counterexample is
reproducible; the values actually consumed are reported from the run log.
-/
namespace Go2Lean.Search

open Go2Lean.SSA Go2Lean.GoSSA Lean

/-- How to generate one Go parameter. Mirrors `contract.ABIParam`. -/
inductive Gen where
  | int (name : String) (w : Nat) (signed : Bool)
  | bool (name : String)
  /-- An opaque `error` parameter: nil or non-nil. -/
  | err (name : String)
  /-- Slice of `w`-bit integers; `maxLen` bounds the generated length. -/
  | slice (name : String) (w : Nat) (signed : Bool) (maxLen : Nat)
  /-- Slice whose elements come from `elem` (structs, strings, pointers,
  nested slices); always materialised on the heap. -/
  | sliceOf (name : String) (elem : Gen) (maxLen : Nat)
  /-- A struct value with the given field generators. -/
  | structv (name : String) (fields : List Gen)
  /-- A pointer: a fresh heap object generated by `pointee`; nil only when
  the depth budget is spent or nil inputs are allowed. -/
  | ptr (name : String) (pointee : Gen)
  /-- A back-edge of a recursive type (`Next *Node` inside `Node`): nil
  with some probability at every depth, so structures of every length
  occur. The Go side tells the two apart from the ABI path. -/
  | link (name : String) (pointee : Gen)
  /-- A string of up to `maxLen` bytes, drawn from the literal pool or a
  small alphabet; for a named string type, mostly one of the constants
  `enum` declared for it. -/
  | str (name : String) (maxLen : Nat) (enum : List (List Nat))
  /-- A pointer that is always nil (kept for ABI records that have no type
  table). -/
  | nilptr (name : String)
  /-- A struct of the named type `tyIdx` in the type table: the way a
  recursive type refers to itself. Generation stops at the depth budget. -/
  | ref (name : String) (tyIdx : Nat)
  /-- A value the model does not look into (interface, map, func, chan,
  float): always `v`, which is `.opaqueNil` when M3 passes nil (the zero
  value of a func, map, channel or interface), a non-nil marker for a
  context (M3 passes `context.Background()`), else `.unit`. -/
  | opaque (name : String) (v : Val)
  /-- A fixed-size array of `n` elements from `elem`. -/
  | arrOf (name : String) (elem : Gen) (n : Nat)

/-- The type table: field generators per named struct type. -/
abbrev TypeTable := Array (List Gen)

/-- The property shape to check. -/
inductive Property where
  | noPanic (f : FuncId)
  /-- `spec` takes the arguments of `f` followed by its result and returns a bool. -/
  | postcondition (f spec : FuncId)

inductive Outcome where
  | holds
  | violated
  | panicked (k : PanicKind)
  | specPanicked (k : PanicKind)
  /-- The spec returned false after reading havoc: unknown, not a refutation. -/
  | specUnknown
  | outOfFuel
  deriving Repr

-- Generation -----------------------------------------------------------------

/-- Boundary values a random search should hit far more often than chance would. -/
def specials (w : Nat) : Array (BitVec w) :=
  #[0#w, 1#w, -1#w, BitVec.intMin w, BitVec.intMax w, BitVec.intMax w - 1#w, BitVec.intMin w + 1#w]

/-- A value profile biases every value of one trial the same way, so that
inputs that must be correlated to trigger a bug (several large elements, all
small indices) are reached far sooner than by independent sampling. -/
inductive Profile where
  | boundary -- only `specials`
  | small    -- magnitudes up to 8
  | mixed    -- 40% specials, otherwise uniform
  deriving Repr

def Profile.ofNat : Nat → Profile
  | 0 => .boundary
  | 1 => .small
  | _ => .mixed

/-- Literals mined from the program, with their off-by-one neighbours, as
`w`-bit values. These join the boundary values so that comparisons against
magic constants are reachable by random search. -/
def mined (w : Nat) (extra : List Nat) : Array (BitVec w) :=
  (extra.flatMap fun c => [BitVec.ofNat w c, BitVec.ofNat w c - 1#w, BitVec.ofNat w c + 1#w]).toArray

def genBits (pf : Profile) (extra : List Nat) (g : StdGen) (w : Nat) : BitVec w × StdGen :=
  let (pick, g) := randNat g 0 9
  let pool := specials w ++ mined w extra
  let special (g : StdGen) :=
    let (i, g) := randNat g 0 pool.size.pred
    (pool[i]!, g)
  match pf with
  | .boundary => special g
  | .small =>
    let (n, g) := randNat g 0 16
    (BitVec.ofInt w (Int.ofNat n - 8), g)
  | .mixed =>
    if pick < 4 then special g
    else
      let (n, g) := randNat g 0 (2 ^ w - 1)
      (BitVec.ofNat w n, g)

/-- Decimal renderings of the mined integers and their neighbours, plus a
few boundary numbers, as byte strings. -/
def numberStrs (extra : List Nat) : List (List Nat) :=
  let fixed : List Int := [0, 1, -1, 255, 256, 65535, 65536, 2147483648, 9223372036854775807, 9223372036854775808]
  let mined : List Int := extra.flatMap fun (c : Nat) => [(c : Int), (c : Int) + 1, (c : Int) - 1]
  ((fixed ++ mined).map fun (v : Int) => itoaBytes v).eraseDups

/-- Bytes a random string is built from: letters, digits and the
punctuation that parsers branch on. -/
def alphabet : Array Nat := #[97, 98, 99, 65, 66, 48, 49, 57, 32, 45, 95, 46, 47, 58, 61, 44, 10]

/-- The depth budget a top-level argument starts with. -/
def topDepth : Nat := 4

/-- The SDKs of OpenAI and Anthropic spell a union as a struct whose
pointer fields are all named `Of<Variant>`: exactly one is set. -/
def Gen.isVariant : Gen → Bool
  | .ptr name _ => name.startsWith "Of"
  | _ => false

/-- The number of `Of<Variant>` pointer fields; two or more make a union. -/
def variantCount (fields : List Gen) : Nat := (fields.filter Gen.isVariant).length

/-- The fields of a union with only its `k`-th variant live: the other
variant pointers become nil. -/
def selectVariant (fields : List Gen) (k : Nat) : List Gen :=
  let rec go (fs : List Gen) (i : Nat) : List Gen :=
    match fs with
    | [] => []
    | f :: rest =>
      if f.isVariant then
        (if i == k then f else match f with | .ptr name _ => .nilptr name | g => g) :: go rest (i + 1)
      else f :: go rest i
  go fields 0

/-- The field generators of a struct, with one union variant chosen at
random when the struct is a union. -/
def chooseFields (g : StdGen) (fields : List Gen) : List Gen × StdGen :=
  let n := variantCount fields
  if n ≥ 2 then
    let (k, g) := randNat g 0 (n - 1)
    (selectVariant fields k, g)
  else (fields, g)

/-- Generate one value. Slices and pointees are materialised on the heap,
so stores through them are exact and the report can dump them. -/
partial def genVal (pf : Profile) (extra : List Nat) (g : StdGen) (heap : Heap Val)
    (pool : List (List Nat) := []) (table : TypeTable := #[]) (depth : Nat := topDepth)
    (allowNil : Bool := true) : Gen → Val × StdGen × Heap Val
  | .int _ w _ =>
    let (v, g) := genBits pf extra g w
    (.int w v, g, heap)
  | .bool _ =>
    let (b, g) := randBool g
    (.bool b, g, heap)
  | .err _ =>
    let (b, g) := randBool g
    (.err b, g, heap)
  | .slice _ w _ maxLen =>
    let (len, g) := randNat g 0 maxLen
    let (extraCap, g) := randNat g 0 2
    let (elems, g) := genMany pf extra g w (len + extraCap)
    let (p, heap) := heapAlloc heap (.arr elems)
    match p with
    | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 (len + extraCap)), g, heap)
    | _ => (.unit, g, heap)
  | .sliceOf _ elem maxLen =>
    -- Nested slices halve their length bound per level, so a struct of
    -- slices of structs of slices stays a few hundred objects per trial
    -- instead of growing exponentially.
    -- At depth zero the slice is empty: `depth - 1` would stay zero and a
    -- union whose variant holds a slice of itself would recurse forever.
    let maxLen := if depth == 0 then 0 else if depth ≥ topDepth then maxLen else maxLen / 2 ^ (topDepth - depth)
    let (len, g) := randNat g 0 maxLen
    let (extraCap, g) := if maxLen == 0 then (0, g) else randNat g 0 2
    let (elems, g, heap) := genList pf extra g heap pool table (depth - 1) allowNil (List.replicate (len + extraCap) elem)
    let (p, heap) := heapAlloc heap (.arr elems)
    match p with
    | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 (len + extraCap)), g, heap)
    | _ => (.unit, g, heap)
  | .structv _ fields =>
    let (fields, g) := chooseFields g fields
    let (vs, g, heap) := genList pf extra g heap pool table depth allowNil fields
    (.structv vs, g, heap)
  | .ptr _ pointee =>
    -- With `allowNil` off (the default) a pointer is nil only once the
    -- depth budget is spent: "a field was never set" findings drown the
    -- ones people act on. With it on: nil one time in five, more often as
    -- the budget runs out.
    let (roll, g) := randNat g 0 4
    if depth == 0 || (allowNil && roll < (if depth ≤ 1 then 3 else 1)) then (.ptr 0 [], g, heap)
    else
      let (obj, g, heap) := genVal pf extra g heap pool table (depth - 1) allowNil pointee
      let (p, heap) := heapAlloc heap obj
      (p, g, heap)
  | .link _ pointee =>
    let (roll, g) := randNat g 0 4
    if depth == 0 || roll < (if depth ≤ 1 then 3 else 1) then (.ptr 0 [], g, heap)
    else
      let (obj, g, heap) := genVal pf extra g heap pool table (depth - 1) allowNil pointee
      let (p, heap) := heapAlloc heap obj
      (p, g, heap)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields =>
      let (fields, g) := chooseFields g fields
      let (vs, g, heap) := genList pf extra g heap pool table depth allowNil fields
      (.structv vs, g, heap)
    | none => (.unit, g, heap)
  | .nilptr _ => (.ptr 0 [], g, heap)
  | .opaque _ v => (v, g, heap)
  | .arrOf _ elem n =>
    -- Below the budget an array holds zero values of its element kind:
    -- the generator for the element at depth zero yields nil pointers and
    -- empty slices, so the recursion ends there.
    let (elems, g, heap) := genList pf extra g heap pool table (depth - 1) allowNil (List.replicate n elem)
    (.arr elems, g, heap)
  | .str _ maxLen enum =>
    -- A named string type: one of its constants three times in four.
    -- Otherwise half the time a pool literal or a neighbour of one (a byte
    -- dropped or added, a mined integer appended: "port:" ++ "65536"), else
    -- random bytes, which are plain digits one time in four. A bound of
    -- zero pins the string to empty (a strings.Builder parameter).
    let numbers := numberStrs extra
    let (pick, g) := randNat g 0 3
    let (fromEnum, g) := randNat g 0 3
    let (bs, g) :=
      if maxLen == 0 then ([], g)
      else if fromEnum < 3 && !enum.isEmpty then
        let (i, g) := randNat g 0 (enum.length - 1)
        (enum[i]!, g)
      else if pick < 2 && !pool.isEmpty then
        let (i, g) := randNat g 0 (pool.length - 1)
        let base := pool[i]!
        let (variant, g) := randNat g 0 7
        match variant with
        | 0 => (base.dropLast, g)
        | 1 => (base ++ [120], g)
        | 2 => (32 :: base, g)
        | 3 | 4 =>
          let (j, g) := randNat g 0 (numbers.length - 1)
          (base ++ numbers[j]!, g)
        | _ => (base, g)
      else
        let (digits, g) := randNat g 0 3
        if digits == 0 then
          let (j, g) := randNat g 0 (numbers.length - 1)
          (numbers[j]!, g)
        else
          let (len, g) := randNat g 0 maxLen
          (List.range len).foldl (fun (acc, g) _ =>
            let (i, g) := randNat g 0 (alphabet.size - 1)
            (acc ++ [alphabet[i]!], g)) ([], g)
    let (v, heap) := strAlloc heap bs
    (v, g, heap)
where
  genMany (pf : Profile) (extra : List Nat) (g : StdGen) (w n : Nat) : List Val × StdGen :=
    (List.range n).foldl (fun (acc, g) _ => let (v, g) := genBits pf extra g w; (acc ++ [.int w v], g)) ([], g)
  -- A loop, not a recursion: a struct can have thousands of leaves.
  genList (pf : Profile) (extra : List Nat) (g : StdGen) (heap : Heap Val) (pool : List (List Nat))
      (table : TypeTable) (depth : Nat) (allowNil : Bool) (gens : List Gen) : List Val × StdGen × Heap Val :=
    let (acc, g, heap) := gens.foldl (fun (acc, g, heap) gen =>
      let (v, g, heap) := genVal pf extra g heap pool table depth allowNil gen
      (v :: acc, g, heap)) (([] : List Val), g, heap)
    (acc.reverse, g, heap)

def genArgs (pf : Profile) (extra : List Nat) (g : StdGen) (gens : List Gen) (pool : List (List Nat) := [])
    (table : TypeTable := #[]) (allowNil : Bool := true) : List Val × StdGen × Heap Val :=
  genVal.genList pf extra g #[] pool table topDepth allowNil gens

/-- Memory contents derived from a per-trial seed and profile. -/
def oracleOf (pf : Profile) (extra : List Nat) (seed : Nat) : Oracle :=
  { mem := fun ref idx =>
      let h := mixHash (mixHash (UInt64.ofNat (seed + 7)) (UInt64.ofNat ref)) (UInt64.ofNat idx.toNat)
      (genBits pf extra (mkStdGen h.toNat) 64).1 }

/-- A havoc oracle derived from the seed. Site widths encode the kind of
value: 0 is an opaque `error` (nil or non-nil), 1 is a bool, 2 is a string
(the empty string: havoc strings carry no bytes until a heap is available
to the oracle), anything else is an integer of that width. -/
def havocOf (seed : Nat) (widths : Array Nat) : Havoc Val := fun site iter =>
  let w := widths[site]?.getD 64
  let h := mixHash (mixHash (UInt64.ofNat seed) (UInt64.ofNat site)) (UInt64.ofNat (iter + 1))
  let g := mkStdGen h.toNat
  if w == 0 then .err (randBool g).1
  else if w == 1 then .bool (randBool g).1
  else if w == 2 then .str 0 0#64 0#64
  else if w == 3 then .unit -- an assumption marker: the value is not used
  else
    let (v, _) := genBits .mixed [] g w
    .int w v

-- Checking -------------------------------------------------------------------

def check (p : GoSSA.Prog) (or : Oracle) (h : Havoc Val) (prop : Property) (args : List Val)
    (fuel : Nat) (heap : Heap Val := #[]) (alts : List (Havoc Val) := []) : Outcome × HState Val × Option Val :=
  match prop with
  | .noPanic f =>
    match run p or h f args fuel heap with
    | (.ok v, s) => (.holds, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) => (.outOfFuel, s, none)
  | .postcondition f spec =>
    match run p or h f args fuel heap with
    | (.ok v, s) =>
      -- A spec takes every result of the target after its parameters.
      let results := match v with | .tuple vs => vs | v => [v]
      let before := s.log.size
      match runFunc p or h spec (args ++ results) s fuel with
      -- A verdict that read a havoc value (the spec compared opaque values,
      -- or called something unmodelled) is neither a refutation nor support,
      -- unless the spec gives the same verdict when rerun from the same
      -- state under each of the other havoc assignments `alts`: then the
      -- havoc it read did not decide it (the trial stays havoc-dependent).
      | (.ok (.bool b), s') =>
        let decided := !alts.isEmpty && alts.all fun h' =>
          match runFunc p or h' spec (args ++ results) s fuel with
          | (.ok (.bool b'), _) => b' == b
          | _ => false
        -- An assumed value (an unmodelled result taken as zero) is the same
        -- under every havoc assignment, so agreement says nothing about it.
        let assumedAt := (s'.log.toList.drop before).find? fun (site, _, _) =>
          p.havocWidths[site]? == some 3
        -- Name the first assumption read, for the engines' moot report.
        let s' := match assumedAt with
          | some (site, _, _) =>
            let origin := match p.siteOrigin[site]? with
              | some (pkg, i) => s!"{pkg}#{i}"
              | none => toString site
            { s' with stuck := s'.stuck <|> some s!"assumption at havoc site {origin}" }
          | none => s'
        if s'.log.size > before && (assumedAt.isSome || !decided) then (.specUnknown, s', some v)
        else if b then (.holds, s', some v) else (.violated, s', some v)
      | (.ok _, s) => (.specPanicked .modelStuck, s, some v)
      | (.panic k, s) => (.specPanicked k, s, some v)
      | (.outOfFuel, s) => (.outOfFuel, s, some v)
    | (.panic k, s) => (.panicked k, s, none)
    | (.outOfFuel, s) => (.outOfFuel, s, none)

/-- Does the outcome refute the property? A stuck model never does. -/
def Outcome.refutes : Property → Outcome → Bool
  | .noPanic _, .panicked k => !k.isStuck
  | .postcondition .., .violated => true
  | _, _ => false

/-- A run that is neither a refutation nor support: the model got stuck, or
a postcondition's target panicked before the oracle ran. Counted so that a
clean pass is not mistaken for a certificate. -/
def Outcome.moot : Property → Outcome → Bool
  | .postcondition .., .panicked _ => true
  | .postcondition .., .specPanicked _ => true
  | .postcondition .., .specUnknown => true
  | _, .panicked k => k.isStuck
  | _, _ => false

-- Reporting ------------------------------------------------------------------

def renderInt (signed : Bool) (v : BitVec w) : String :=
  if signed then toString v.toInt else toString v.toNat

/-- Flatten one argument into the model parameter names M3 expects. -/
def flatten : Gen → Val → List (String × Json)
  | .int name _ signed, .int _ v => [(name, renderInt signed v)]
  | .bool name, .bool b => [(name, toString b)]
  | .err name, .err nonNil => [(name, if nonNil then "error" else "nil")]
  | .slice name _ _ _, .slice ref off len cap
  | .sliceOf name _ _, .slice ref off len cap =>
    [(name ++ "_ref", toString ref), (name ++ "_off", renderInt false off),
     (name ++ "_len", renderInt false len), (name ++ "_cap", renderInt false cap)]
  | .structv .., _ => []
  | .ptr .., _ => []
  | .link .., _ => []
  | .str .., _ => [] -- reported under objects, where the heap is available
  | .nilptr .., _ => []
  | .ref .., _ => []
  | .opaque .., _ => []
  | .arrOf .., _ => []
  | g, _ => [(genName g, "?")]
where
  genName : Gen → String
    | .int n .. => n | .bool n => n | .err n => n | .slice n .. => n | .structv n .. => n | .ptr n .. => n
    | .str n .. => n | .nilptr n => n | .ref n _ => n | .sliceOf n .. => n | .opaque n _ => n | .arrOf n .. => n | .link n _ => n

/-- Bytes as a JSON string (UTF-8 decoded; invalid sequences become U+FFFD). -/
def bytesToJson (bs : List Nat) : Json :=
  Json.str (String.fromUTF8! (ByteArray.mk (bs.map fun b => UInt8.ofNat b).toArray))

/-- Render a value as the JSON M3 materialises: integers and bools as
strings, structs as arrays of fields, pointers as null or the pointee. -/
partial def renderObj (heap : Heap Val) (signed : Bool) : Val → Json
  | .int _ v => Json.str (renderInt signed v)
  | .bool b => Json.str (toString b)
  | .err nonNil => Json.str (if nonNil then "error" else "nil")
  | .structv fs => Json.arr (fs.map (renderObj heap signed)).toArray
  | .arr es => Json.arr (es.map (renderObj heap signed)).toArray
  | .ptr 0 _ => Json.null
  | .ptr ref path =>
    match heap[ref]? >>= (getPath · path) with
    -- A non-nil pointer to an opaque object: not null, so M3 builds a
    -- pointer to the pointee's zero value instead of passing nil.
    | some .unit | some .opaqueNil | some (.boxed ..) => Json.str "opaque"
    | some v => renderObj heap signed v
    | none => Json.str "?"
  | .slice 0 _ _ _ => Json.null
  | .unit => Json.null
  -- Opaque values: M3 passes the zero value (nil) for inputs of these types.
  | .opaqueNil => Json.null
  | .boxed .. => Json.null
  | s@(.str ..) =>
    match strBytes heap s with
    | some bs => bytesToJson bs
    | none => Json.str "?"
  | .slice ref off len _ =>
    match heap[ref]? with
    | some (.arr es) => Json.arr ((es.drop off.toNat).take len.toNat |>.map (renderObj heap signed)).toArray
    | _ => Json.str "?"
  | v => Json.str (toString (repr v))

/-- The slice contents of each slice argument (from the heap when
materialised, else from the oracle), keyed by parameter name. -/
def memoryOf (or : Oracle) (heap : Heap Val) (gens : List Gen) (args : List Val) : List (String × Json) :=
  (gens.zip args).filterMap fun
    | (.slice name w signed _, .slice ref off len cap) =>
      match heap[ref]? with
      | some (.arr _) => some (name, renderObj heap signed (.slice ref off len cap))
      | _ =>
        let elems := (List.range len.toNat).map fun j =>
          Json.str (renderInt signed ((or.mem ref (off + BitVec.ofNat 64 j)).zeroExtend w))
        some (name, Json.arr elems.toArray)
    | _ => none

/-- Struct and pointer arguments as nested JSON, keyed by parameter name. -/
def objectsOf (heap : Heap Val) (gens : List Gen) (args : List Val) : List (String × Json) :=
  (gens.zip args).filterMap fun
    | (.structv name _, v) => some (name, renderObj heap true v)
    | (.ptr name _, v) => some (name, renderObj heap true v)
    | (.link name _, v) => some (name, renderObj heap true v)
    | (.str name .., v) => some (name, renderObj heap true v)
    | (.nilptr name, v) => some (name, renderObj heap true v)
    | (.ref name _, v) => some (name, renderObj heap true v)
    | (.sliceOf name _ _, v) => some (name, renderObj heap true v)
    | (.opaque name _, _) => some (name, Json.null)
    | (.arrOf name _ _, v) => some (name, renderObj heap true v)
    | _ => none

partial def renderVal : Val → Json
  | .int _ v => Json.str (renderInt true v)
  | .bool b => Json.str (toString b)
  | .slice ref off len cap =>
    Json.str s!"slice(ref={ref}, off={off.toNat}, len={len.toNat}, cap={cap.toNat})"
  | .tuple vs => Json.arr (vs.map renderVal).toArray
  | .err nonNil => Json.str (if nonNil then "error" else "nil")
  | .ptr 0 _ => Json.str "nil"
  | .ptr ref path => Json.str s!"ptr(ref={ref}, path={path})"
  | .str ref off len => Json.str s!"str(ref={ref}, off={off.toNat}, len={len.toNat})"
  | .structv fs => Json.arr (fs.map renderVal).toArray
  | .arr es => Json.arr (es.map renderVal).toArray
  | .boxed t v => Json.mkObj [("type", (t : Json)), ("value", renderVal v)]
  | .opaqueNil => Json.str "nil"
  | .unit => Json.str "unit"

def modelOutput : Outcome → Option Val → Json
  | .panicked k, _ => Json.mkObj [("res", "panic"), ("panic", k.tag)]
  | .specPanicked k, v =>
    Json.mkObj [("res", "spec_panic"), ("panic", k.tag), ("value", (v.map renderVal).getD Json.null)]
  | .outOfFuel, _ => Json.mkObj [("res", "out_of_fuel")]
  | _, v => Json.mkObj [("res", "ok"), ("value", (v.map renderVal).getD Json.null)]

def report (or : Oracle) (heap : Heap Val) (gens : List Gen) (args : List Val) (trial seed : Nat)
    (o : Outcome) (s : HState Val) (ret : Option Val) : Json :=
  let inputs := (gens.zip args).flatMap (fun (g, v) => flatten g v)
  let memory := memoryOf or heap gens args
  let objects := objectsOf heap gens args
  let havoc := s.log.toList.map fun (site, iter, v) =>
    Json.mkObj [("idx", site), ("iter", iter), ("value", renderVal v)]
  Json.mkObj [("found", true), ("trial", trial), ("seed", seed),
    ("inputs", Json.mkObj inputs), ("memory", Json.mkObj memory), ("objects", Json.mkObj objects),
    ("havoc", Json.arr havoc.toArray),
    ("model_output", modelOutput o ret)]

/-- The block a postcondition's spec returned from, when the spec ran to
its end (the trial reached the oracle and the oracle finished). -/
def specExit (prop : Property) (o : Outcome) (s : HState Val) : Option String :=
  match prop, o with
  | .postcondition .., .holds | .postcondition .., .violated =>
    s.exit.map fun (_, b) => toString b
  | _, _ => none

/-- Run `trials` random trials; print one JSON line, `{"found": false, ...}` if nothing refutes. -/
def run (p : GoSSA.Prog) (prop : Property) (gens : List Gen) (extra : List Nat)
    (seed trials fuel : Nat) (strs : List String := []) (table : TypeTable := #[])
    (allowNil : Bool := true) (budgetMs : Nat := 0) : IO Unit := do
  let pool := strs.map fun s => s.toUTF8.toList.map (·.toNat)
  let mut g := mkStdGen seed
  let mut fuelOuts := 0
  let mut moots := 0
  let mut stuckSites : List (String × Nat) := []
  let mut fallback : Option Json := none
  let mut exits : List (String × Nat) := []
  let trace := (← IO.getEnv "GO2LEAN_TRACE").isSome
  let start ← IO.monoMsNow
  let mut done := 0
  for trial in [0:trials] do
    -- A wall-clock budget (0: none) bounds a property whose inputs are
    -- expensive to draw; the report says how many trials ran.
    if budgetMs > 0 && (← IO.monoMsNow) - start > budgetMs then break
    done := trial + 1
    let (pfn, g') := randNat g 0 2
    g := g'
    let pf := Profile.ofNat pfn
    -- Memory and havoc are re-drawn every trial; the trial seed makes them reproducible.
    let tseed := (mixHash (UInt64.ofNat seed) (UInt64.ofNat trial)).toNat
    let or := oracleOf pf extra tseed
    let h := havocOf tseed p.havocWidths
    let (args, g', heap) := genArgs pf extra g gens pool table allowNil
    g := g'
    if trace then
      -- GO2LEAN_TRACE: every input before it runs, for crashes that leave
      -- no report behind.
      IO.eprintln (Json.mkObj [("trial", trial), ("objects", Json.mkObj (objectsOf heap gens args)),
        ("inputs", Json.mkObj ((gens.zip args).flatMap fun (g, v) => flatten g v))]).compress
    let alts := [havocOf (tseed + 7919) p.havocWidths, havocOf (tseed + 104729) p.havocWidths]
    let (o, s, ret) := check p or h prop args fuel heap alts
    if trace then IO.eprintln s!"done trial {trial}: {repr o}"
    if o.refutes prop then
      -- Report the initial heap: what the inputs looked like before the run.
      -- A refutation whose run read a havoc value (an unmodelled call) is
      -- kept as a fallback while the search goes on for one that did not:
      -- M3 refutes most havoc-dependent ones.
      let j := report or heap gens args trial seed o s ret
      if s.log.size == 0 then
        IO.println j.compress
        return
      else if fallback.isNone then
        fallback := some j
    if let .outOfFuel := o then fuelOuts := fuelOuts + 1
    if let some b := specExit prop o s then exits := bump exits b
    if o.moot prop then
      moots := moots + 1
      if let some site := s.stuck then stuckSites := bump stuckSites site
  if let some j := fallback then
    IO.println (j.setObjVal! "havoc_dependent" true).compress
    return
  let top := (stuckSites.toArray.qsort (fun a b => a.2 > b.2)).toList.take 5
  IO.println (Json.mkObj [("found", false), ("trials", done), ("out_of_fuel", fuelOuts),
    ("moot", moots), ("budget_hit", decide (done < trials)),
    ("stuck_sites", Json.mkObj (top.map fun (site, n) => (site, (n : Json)))),
    ("spec_exits", Json.mkObj (exits.map fun (b, n) => (b, (n : Json))))]).compress
where
  bump (sites : List (String × Nat)) (site : String) : List (String × Nat) :=
    match sites.lookup site with
    | some n => (site, n + 1) :: sites.filter (·.1 != site)
    | none => (site, 1) :: sites

-- Exhaustive engine ---------------------------------------------------------

/-- The value set the exhaustive engine enumerates for `w`-bit integers:
boundary values, mined literals and their neighbours, and magnitudes up to 8. -/
def smallInts (w : Nat) (extra : List Nat) : List (BitVec w) :=
  ((specials w ++ mined w extra).toList ++
    (List.range 17).map fun n => BitVec.ofInt w (Int.ofNat n - 8)).eraseDups

/-- All length-`n` tuples over `xs`. -/
def tuples (xs : List α) : Nat → List (List α)
  | 0 => [[]]
  | n + 1 => (tuples xs n).flatMap fun t => xs.map (· :: t)

/-- The strings the exhaustive engine tries: the empty string, a space, one
letter, one digit, the boundary numbers, and every pool literal with its
neighbours and number suffixes. -/
def smallStrs (extra : List Nat) (pool : List (List Nat)) : List (List Nat) :=
  let numbers := numberStrs extra
  ([[], [32], [97], [48]] ++ numbers ++
    pool.flatMap fun (b : List Nat) => [b, b.dropLast, b ++ [120]] ++ numbers.map (b ++ ·)).eraseDups

/-- Enumerate one parameter as a heap-building function: each candidate
takes the heap so far and returns the value and the extended heap. -/
partial def enumGen (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable := #[])
    (depth : Nat := 2) (allowNil : Bool := true) : Gen → List (Heap Val → Val × Heap Val)
  | .int _ w _ => (smallInts w extra).map fun v heap => (.int w v, heap)
  | .bool _ => [fun heap => (.bool true, heap), fun heap => (.bool false, heap)]
  | .err _ => [fun heap => (.err false, heap), fun heap => (.err true, heap)]
  | .slice _ w _ maxLen' =>
    let elems := (smallInts w extra).map fun v => Val.int w v
    (List.range (min maxLen maxLen' + 1)).flatMap fun len =>
      (tuples elems len).map fun t heap =>
        let (p, heap) := heapAlloc heap (.arr t)
        match p with
        | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 len), heap)
        | _ => (.unit, heap)
  | .sliceOf _ elem maxLen' =>
    (List.range (if depth == 0 then 1 else min maxLen maxLen' + 1)).flatMap fun len =>
      (enumList extra maxLen pool table (depth - 1) allowNil (List.replicate len elem)).map fun build heap =>
        let (vs, heap) := build heap
        let (p, heap) := heapAlloc heap (.arr vs)
        match p with
        | .ptr ref _ => (.slice ref 0#64 (BitVec.ofNat 64 len) (BitVec.ofNat 64 len), heap)
        | _ => (.unit, heap)
  | .structv _ fields =>
    (enumVariants fields).flatMap fun fields =>
      (enumList extra maxLen pool table depth allowNil fields).map fun build heap =>
        let (vs, heap) := build heap
        (.structv vs, heap)
  | .ptr _ pointee =>
    (if depth > 0 && !allowNil then [] else [fun heap => (.ptr 0 [], heap)]) ++
      (if depth == 0 then [] else
        (enumGen extra maxLen pool table (depth - 1) allowNil pointee).map fun build heap =>
          let (obj, heap) := build heap
          heapAlloc heap obj)
  | .link _ pointee =>
    [fun heap => (.ptr 0 [], heap)] ++
      (if depth == 0 then [] else
        (enumGen extra maxLen pool table (depth - 1) allowNil pointee).map fun build heap =>
          let (obj, heap) := build heap
          heapAlloc heap obj)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields =>
      (enumVariants fields).flatMap fun fields =>
        (enumList extra maxLen pool table depth allowNil fields).map fun build heap =>
          let (vs, heap) := build heap
          (.structv vs, heap)
    | none => [fun heap => (.unit, heap)]
  | .str _ maxLen' enum =>
    -- A named string type: its constants, the empty string and one other.
    let strs := if maxLen' == 0 then [[]]
      else if !enum.isEmpty then (enum ++ [[], [97]]).eraseDups
      else smallStrs extra pool
    strs.map fun bs heap => strAlloc heap bs
  | .nilptr _ => [fun heap => (.ptr 0 [], heap)]
  | .opaque _ v => [fun heap => (v, heap)]
  | .arrOf _ elem n =>
    (enumList extra maxLen pool table (depth - 1) allowNil (List.replicate n elem)).map fun build heap =>
      let (vs, heap) := build heap
      (.arr vs, heap)
where
  /-- The field lists to enumerate: one per variant for a union, else the
  fields as they are. -/
  enumVariants (fields : List Gen) : List (List Gen) :=
    let n := variantCount fields
    if n ≥ 2 then (List.range n).map (selectVariant fields) else [fields]
  enumList (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable) (depth : Nat)
      (allowNil : Bool) : List Gen → List (Heap Val → List Val × Heap Val)
    | [] => [fun heap => ([], heap)]
    | g :: gs =>
      (enumGen extra maxLen pool table depth allowNil g).flatMap fun build =>
        (enumList extra maxLen pool table depth allowNil gs).map fun rest heap =>
          let (v, heap) := build heap
          let (vs, heap) := rest heap
          (v :: vs, heap)

/-- The number of leaf generators in a description, table references
expanded once: the exhaustive engine only enumerates small signatures,
since the builders of a wide structure are expensive to construct even
when the domain is small. -/
partial def leaves (table : TypeTable) (seen : List Nat := []) : Gen → Nat
  | .structv _ fields => structLeaves table seen fields
  | .ptr _ pointee | .link _ pointee | .sliceOf _ pointee _ | .arrOf _ pointee _ => 1 + leaves table seen pointee
  | .ref _ tyIdx =>
    if seen.contains tyIdx then 1
    else match table[tyIdx]? with
      | some fields => structLeaves table (tyIdx :: seen) fields
      | none => 1
  | _ => 1
where
  /-- A union counts its widest variant, since one is live at a time. -/
  structLeaves (table : TypeTable) (seen : List Nat) (fields : List Gen) : Nat :=
    let (vars, rest) := fields.partition Gen.isVariant
    (rest.map (leaves table seen)).sum +
      (if vars.length ≥ 2 then (vars.map (leaves table seen)).foldl max 0 else (vars.map (leaves table seen)).sum)

/-- Size of the domain `enumArgs` would produce, computed before building it. -/
partial def genSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable := #[])
    (depth : Nat := 2) (allowNil : Bool := true) : Gen → Nat
  | .int _ w _ => (smallInts w extra).length
  | .bool _ => 2
  | .err _ => 2
  | .slice _ w _ maxLen' =>
    let k := (smallInts w extra).length
    (List.range (min maxLen maxLen' + 1)).foldl (fun acc len => acc + k ^ len) 0
  | .sliceOf _ elem maxLen' =>
    let k := genSize extra maxLen pool table (depth - 1) allowNil elem
    (List.range (if depth == 0 then 1 else min maxLen maxLen' + 1)).foldl (fun acc len => acc + k ^ len) 0
  | .structv _ fields => structSize extra maxLen pool table depth allowNil fields
  | .ptr _ pointee => (if depth > 0 && !allowNil then 0 else 1) + (if depth == 0 then 0 else genSize extra maxLen pool table (depth - 1) allowNil pointee)
  | .link _ pointee => 1 + (if depth == 0 then 0 else genSize extra maxLen pool table (depth - 1) allowNil pointee)
  | .ref _ tyIdx =>
    match table[tyIdx]? with
    | some fields => structSize extra maxLen pool table depth allowNil fields
    | none => 1
  | .str _ maxLen' enum =>
    if maxLen' == 0 then 1 else if !enum.isEmpty then (enum ++ [[], [97]]).eraseDups.length
    else (smallStrs extra pool).length
  | .opaque .. => 1
  | .arrOf _ elem n => (genSize extra maxLen pool table (depth - 1) allowNil elem) ^ n
  | .nilptr _ => 1
where
  structSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (table : TypeTable) (depth : Nat)
      (allowNil : Bool) (fields : List Gen) : Nat :=
    let product (fs : List Gen) := fs.foldl (fun acc f => acc * genSize extra maxLen pool table depth allowNil f) 1
    let n := variantCount fields
    if n ≥ 2 then ((List.range n).map fun k => product (selectVariant fields k)).sum else product fields

def domainSize (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (gens : List Gen)
    (table : TypeTable := #[]) (allowNil : Bool := true) : Nat :=
  gens.foldl (fun acc g => acc * genSize extra maxLen pool table 2 allowNil g) 1

/-- The inputs of the small domain as heap builders, so that the heaps are
built one at a time inside the engine's budget. -/
def enumArgs (extra : List Nat) (maxLen : Nat) (pool : List (List Nat)) (gens : List Gen)
    (table : TypeTable := #[]) (allowNil : Bool := true) : List (Heap Val → List Val × Heap Val) :=
  enumGen.enumList extra maxLen pool table 2 allowNil gens

/-- Try every input in the small domain. Prints a counterexample line, or
`{"found": false, "exhaustive": true, ...}` when the whole domain holds, or
`"exhaustive": false` when the domain exceeds `limit`. Havoc sites (if any)
are not enumerated; they take seed-derived values. -/
def exhaust (p : GoSSA.Prog) (prop : Property) (gens : List Gen) (extra : List Nat)
    (maxLen limit fuel : Nat) (strs : List String := []) (table : TypeTable := #[])
    (allowNil : Bool := true) (budgetMs : Nat := 0) : IO Unit := do
  let pool := strs.map fun s => s.toUTF8.toList.map (·.toNat)
  let width := (gens.map (leaves table)).sum
  if width > 24 then
    IO.println (Json.mkObj [("found", false), ("exhaustive", false),
      ("reason", "signature too wide"), ("domain", width), ("limit", 24)]).compress
    return
  let n := domainSize extra maxLen pool gens table allowNil
  if n > limit then
    IO.println (Json.mkObj [("found", false), ("exhaustive", false),
      ("reason", "domain too large"), ("domain", (min n (10 ^ 300) : Nat)), ("limit", limit)]).compress
    return
  let h := havocOf 0 p.havocWidths
  let or := oracleOf .mixed extra 0
  let mut fuelOuts := 0
  let mut moots := 0
  let mut i : Nat := 0
  let mut fallback : Option Json := none
  let mut exits : List (String × Nat) := []
  let start ← IO.monoMsNow
  for build in enumArgs extra maxLen pool gens table allowNil do
    let (args, heap) := build #[]
    if budgetMs > 0 && (← IO.monoMsNow) - start > budgetMs then
      -- Out of time: no certificate, but say how far it got.
      IO.println (Json.mkObj [("found", false), ("exhaustive", false), ("reason", "budget"),
        ("domain", n), ("limit", limit), ("checked", (i : Nat))]).compress
      return
    let (o, s, ret) := check p or h prop args fuel heap [havocOf 1 p.havocWidths, havocOf 2 p.havocWidths]
    if o.refutes prop then
      let j := report or heap gens args i 0 o s ret
      if s.log.size == 0 then
        IO.println j.compress
        return
      else if fallback.isNone then
        fallback := some j
    if let .outOfFuel := o then fuelOuts := fuelOuts + 1
    if let some b := specExit prop o s then exits := run.bump exits b
    if o.moot prop then moots := moots + 1
    i := i + 1
  if let some j := fallback then
    IO.println (j.setObjVal! "havoc_dependent" true).compress
    return
  IO.println (Json.mkObj [("found", false), ("exhaustive", fuelOuts == 0 && moots == 0), ("domain", n),
    ("out_of_fuel", fuelOuts), ("moot", moots), ("max_len", maxLen),
    ("havoc_sites", p.havocWidths.size),
    ("spec_exits", Json.mkObj (exits.map fun (b, n) => (b, (n : Json))))]).compress

end Go2Lean.Search
